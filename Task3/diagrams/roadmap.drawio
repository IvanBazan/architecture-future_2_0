                <mxCell id="62" value="&lt;strong&gt;Результаты Q2:&lt;/strong&gt;&lt;div&gt;&lt;ul&gt;&lt;li&gt;&lt;span style=&quot;font-size: 8px;&quot;&gt;&lt;b&gt;реализован subscriber для событий из брокера в старый DWH&lt;/b&gt;&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;font-size: 8px;&quot;&gt;&lt;b&gt;настрое RBAC в мед контуре&lt;/b&gt;&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;font-size: 8px;&quot;&gt;&lt;b&gt;запущен МЕД сервис&lt;/b&gt;&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;font-size: 8px;&quot;&gt;&lt;b&gt;подняты БД и хранилище для маскированных данных для ИИ&lt;/b&gt;&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;font-size: 8px;&quot;&gt;&lt;b&gt;настроена интеграция финансового сервиса с брокером&lt;/b&gt;&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;font-size: 8px;&quot;&gt;&lt;b&gt;доработана шина для интеграции новых сервисов к бизнес домену в старом DWH&lt;/b&gt;&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;font-size: 8px;&quot;&gt;&lt;b&gt;начата миграция данных в МЕД домен и финтех домен&lt;/b&gt;&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;font-size: 8px;&quot;&gt;&lt;b&gt;начата реализация DataAggregator для очишения и маскировки при миграции мед данных в ИИ контур&lt;/b&gt;&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;font-size: 8px;&quot;&gt;&lt;b&gt;начата настройка RBAC в ИИ контуре&lt;/b&gt;&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;font-size: 8px;&quot;&gt;&lt;b&gt;начата разработка DataApi витрины&amp;nbsp;&lt;/b&gt;&lt;/span&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;" style="text;whiteSpace=wrap;html=1;" vertex="1" parent="1">
